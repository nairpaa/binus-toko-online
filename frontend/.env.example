# Monitoring (opsional). Kosongkan kalau tidak dipakai, misalnya saat develop di lokal.
# Isi di dashboard Vercel/Netlify (Environment Variables), bukan di sini, untuk versi production.

# Google Analytics 4: Admin > Data streams > (pilih stream web) > Measurement ID
VITE_GA_MEASUREMENT_ID=

# LogRocket: Settings > General Settings > Application ID (format: abcdef/nama-project)
VITE_LOGROCKET_APP_ID=
