# Salin file ini jadi .env lalu sesuaikan isinya.
PORT=5000

# Lokal: MongoDB di komputer/Docker. Production: connection string MongoDB Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/toko_online

# Kunci rahasia untuk menandatangani access token (JWT). Wajib diisi, buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# Umur access token (format: 30s, 15m, 1h). Dibuat pendek karena disimpan di localStorage.
ACCESS_TOKEN_EXPIRES_IN=15m
# Umur refresh token dalam hari. Selama masih berlaku, user tidak perlu login ulang.
REFRESH_TOKEN_EXPIRES_DAYS=7
# Batas mutlak satu sesi login (hari sejak login). Setelah ini wajib login ulang walaupun aktif terus.
SESSION_MAX_DAYS=30

# Berapa lapis proxy yang dipercaya untuk membaca IP asli pengunjung (dipakai rate limit registrasi).
# Lokal: loopback (proxy Vite). Render di belakang Vercel/Netlify: 2. Cek hasilnya di /api/health.
TRUST_PROXY=loopback

# Akun admin yang dibuat oleh `npm run seed` / `npm run seed:admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-ini
ADMIN_NAME=Admin Toko
